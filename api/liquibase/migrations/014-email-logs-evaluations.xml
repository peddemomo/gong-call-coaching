<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add value_point_evaluations JSONB column to email_logs for storing evaluation results -->
    <changeSet id="014-add-email-logs-evaluations" author="system">
        <addColumn tableName="email_logs">
            <column name="value_point_evaluations" type="JSONB"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
